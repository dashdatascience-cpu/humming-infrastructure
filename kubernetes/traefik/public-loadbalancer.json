{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "jenkins-public",
    "namespace": "jenkins"
  },
  "spec": {
    "type": "LoadBalancer",
    "loadBalancerClass": "networking.gke.io/l4-regional-external",
    "selector": {
      "app.kubernetes.io/instance": "humming-traefik-jenkins",
      "app.kubernetes.io/name": "traefik"
    },
    "ports": [
      {
        "name": "http",
        "nodePort": 31072,
        "port": 80,
        "protocol": "TCP",
        "targetPort": 8000
      }
    ]
  }
}
